# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE_SERVICE_ACCOUNT_CREDENTIALS (Optional):
# Paste the full JSON string of your Google Cloud Service Account key to enable server-side Google Sheets sync.
# Alternatively, set GOOGLE_CLIENT_EMAIL and GOOGLE_PRIVATE_KEY individually.
# GOOGLE_SERVICE_ACCOUNT_CREDENTIALS='{"type":"service_account",...}'
# GOOGLE_CLIENT_EMAIL="your-service-account@project.iam.gserviceaccount.com"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
